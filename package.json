{
  "name": "enforce-label-action",
  "version": "1.0.0",
  "description": "Enforce PR labels for Github Actions",
  "main": "dist/main.js",
  "scripts": {
    "buildForAction": "esbuild --bundle src/main.ts --outdir=dist --minify --platform=node",
    "format": "prettier --write src/*.ts",
    "lintCi": "prettier -c src/*.ts",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogevbd/enforce-label-action.git"
  },
  "keywords": [
    "actions",
    "github",
    "labels",
    "lint"
  ],
  "author": "Yogev Ben David <yogev132@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@jest/globals": "^29.7.0",
    "@types/node": "^14.14.2",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.9",
    "esbuild-plugin-tsc": "^0.5.0",
    "jest": "^30.4",
    "prettier": "^2.1.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.15.0"
}
